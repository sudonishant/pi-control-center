<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19">

    <!-- WebView Container -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0F19"
        android:visibility="gone" />

    <!-- Setup IP Input Screen -->
    <LinearLayout
        android:id="@+id/setup_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="visible">

        <!-- Glassmorphism Container Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp"
            android:background="@drawable/card_bg"
            android:elevation="8dp">

            <!-- Small Neon SVG CPU Logo -->
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_logo_chip"
                android:contentDescription="PiControl Logo"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PiControl Android"
                android:textColor="#00F2C3"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter the IP &amp; Port of your PiControl server"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="28dp" />

            <EditText
                android:id="@+id/ip_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. 10.82.32.172 or 192.168.1.100:3000"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:inputType="textUri"
                android:padding="16dp"
                android:textSize="14sp"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/connect_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connect to Dashboard"
                android:background="@drawable/button_bg"
                android:textColor="#0B0F19"
                android:padding="16dp"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Page Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_centerInParent="true"
        android:indeterminateTint="#00F2C3"
        android:visibility="gone" />

</RelativeLayout>
